<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sdyfy.medical.mapper.PrescriptionMapper">
    <resultMap id="PrescriptionResult" type="com.sdyfy.medical.domain.Prescription">
        <id property="id" column="id" />
        <result property="prescriptionName" column="prescription_name" />
        <result property="functionDesc" column="function_desc" />
        <result property="indications" column="indications" />
        <result property="preparationMethod" column="preparation_method" />
        <result property="sourceClassic" column="source_classic" />
        <result property="remarks" column="remarks" />
        <result property="createTime" column="created_at" />
        <result property="updateTime" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id, prescription_name, function_desc, indications, preparation_method, source_classic, remarks, created_at, updated_at
    </sql>

    <select id="selectPrescriptionById" resultMap="PrescriptionResult">
        select <include refid="Base_Column_List" />
        from prescriptions
        where id = #{id}
    </select>

    <select id="selectPrescriptionByName" resultMap="PrescriptionResult">
        select <include refid="Base_Column_List" />
        from prescriptions
        where prescription_name = #{prescriptionName}
        limit 1
    </select>

    <select id="selectPrescriptionList" parameterType="com.sdyfy.medical.domain.Prescription" resultMap="PrescriptionResult">
        select <include refid="Base_Column_List" />
        from prescriptions
        <where>
            <if test="prescriptionName != null and prescriptionName != ''">and prescription_name like concat('%', #{prescriptionName}, '%')</if>
            <if test="sourceClassic != null and sourceClassic != ''">and source_classic like concat('%', #{sourceClassic}, '%')</if>
        </where>
    </select>

    <insert id="insertPrescription" parameterType="com.sdyfy.medical.domain.Prescription">
        insert into prescriptions (
            prescription_name, function_desc, indications, preparation_method, source_classic, remarks, created_at, updated_at
        ) values (
            #{prescriptionName}, #{functionDesc}, #{indications}, #{preparationMethod}, #{sourceClassic}, #{remarks}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updatePrescription" parameterType="com.sdyfy.medical.domain.Prescription">
        update prescriptions
        <set>
            <if test="prescriptionName != null">prescription_name = #{prescriptionName},</if>
            <if test="functionDesc != null">function_desc = #{functionDesc},</if>
            <if test="indications != null">indications = #{indications},</if>
            <if test="preparationMethod != null">preparation_method = #{preparationMethod},</if>
            <if test="sourceClassic != null">source_classic = #{sourceClassic},</if>
            <if test="remarks != null">remarks = #{remarks},</if>
            updated_at = #{updateTime}
        </set>
        where id = #{id}
    </update>

    <delete id="deletePrescriptionById">
        delete from prescriptions where id = #{id}
    </delete>

    <delete id="deletePrescriptionByIds">
        delete from prescriptions where id in
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
